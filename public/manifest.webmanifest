{
  "id": ".",
  "name": "Remembos — your private memory",
  "short_name": "Remembos",
  "description": "Drop screenshots, PDFs, videos, voice notes and text. Remembos makes them searchable — privately, on your device. No uploads, no account.",
  "lang": "en",
  "dir": "ltr",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fbfbfd",
  "theme_color": "#fbfbfd",
  "categories": ["productivity", "utilities"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "screenshots/home-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Drop anything to remember it"
    },
    {
      "src": "screenshots/home-narrow.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Your private memory on your phone"
    }
  ],
  "shortcuts": [
    {
      "name": "Upload files",
      "short_name": "Upload",
      "description": "Add screenshots, PDFs, videos, voice or text",
      "url": "./?action=upload",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Paste from clipboard",
      "short_name": "Paste",
      "description": "Remember what you just copied",
      "url": "./?action=paste",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Record voice",
      "short_name": "Record",
      "description": "Record a voice note, transcribed on your device",
      "url": "./?action=record",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Search memories",
      "short_name": "Search",
      "description": "Find anything you saved",
      "url": "search/",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*", "audio/*", "application/pdf", "text/*", ".pdf", ".txt", ".md"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".avif"],
        "application/pdf": [".pdf"],
        "audio/*": [".mp3", ".m4a", ".wav", ".ogg", ".opus", ".flac", ".aac", ".webm"],
        "video/*": [".mp4", ".mov", ".m4v", ".webm"],
        "text/plain": [".txt", ".md", ".csv", ".json", ".vtt", ".srt"]
      }
    }
  ]
}
